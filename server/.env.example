# Copy to .env (gitignored) for local dev, or set these in cPanel
# "Setup Node.js App" -> Environment variables.

# Supabase Postgres (Session pooler). URL-encode special chars in the password
# (e.g. "@" -> %40). Do NOT append ?sslmode=... — SSL is handled in db.js.
DATABASE_URL=postgresql://postgres.oazvkbvqbarghmcxiagc:YOUR_URL_ENCODED_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Long random string (32+ bytes). Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-secret

# Token lifetime (optional, default 1d).
JWT_EXPIRES_IN=1d

# Comma-separated allow-list of browser origins that may call the API.
CORS_ORIGINS=https://accounting.astrochakra.co

# Port. On cPanel/Passenger this is provided automatically; for local dev:
PORT=3001

# Optional: max pooled DB connections (default 5).
DB_POOL_MAX=5
